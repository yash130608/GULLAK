PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gullak
# Use a long random secret (at least 32 characters). Keep it private.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Optional AI insights
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Set PGSSL=disable only for a local PostgreSQL setup that does not use SSL.
